{
  "name": "lint-and-format",
  "version": "1.0.0",
  "description": "Set up, tune and extend ESLint + Prettier on a TypeScript project",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
